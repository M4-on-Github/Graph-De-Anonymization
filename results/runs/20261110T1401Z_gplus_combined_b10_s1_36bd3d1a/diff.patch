+        compare_match(mo, mn)
+        fa_old = timed("old find_anchors (given old F)", old.find_anchors, Ga, Gu,
+                       n_anch, csls_k, nodes_a, nodes_u, Fo_a, Fo_u, False)
+        check("old find_anchors == new find_anchors", fa_old == fa_new)
