Bootstrap: docker
From: python:3.12-slim

# The environment for both halves of this repo: the Report 1 baseline (CPU --
# networkx, numpy, matplotlib) and the Adv-GD module (GPU -- torch). One image
# rather than two, because the second is the first plus torch and the pip
# wheel carries its own CUDA libraries; `apptainer exec --nv` is all the GPU
# job adds.
#
# pleiades has no python newer than 3.6 outside a container and no sudo, which
# is why this exists at all: networkx 3.7 and numpy 2.5 both require 3.12+.
# `scripts/moes-cluster-scripts/grid.py` is deliberately 3.6-compatible so that
# a submit script on the head node can size an array without the container.
#
# Versions are the ones pinned in the repo's requirements.txt. That file is a
# superset -- it also pins the nvidia-* and cuda-* wheels that torch pulls in
# transitively -- so the five lines below are the direct dependencies and pip
# resolves the rest.

%post
    set -eu

    # git is not a convenience here: provenance.git_state() shells out to it
    # for the commit, the branch and the uncommitted diff, and with
    # --containall the host's git is not visible. Without it every record
    # would carry an empty `git.head`, which the logging policy calls a lie.
    apt-get update
    apt-get install -y --no-install-recommends git ca-certificates
    rm -rf /var/lib/apt/lists/*

    # scipy is not a direct import anywhere in this repo, but networkx's
    # pagerank lazy-imports it internally (the sparse solver backing
    # pagerank_scipy) and raises ModuleNotFoundError at call time, not at
    # `import networkx`, which is why the first build missed it. 1.18.1 is
    # the release pip resolved against numpy==2.5.3 when this was added;
    # pinned here (and in requirements.txt) so a later build can't silently
    # pick up a scipy that drops support for this numpy.
    pip install --no-cache-dir \
        "networkx==3.7" \
        "numpy==2.5.3" \
        "scipy==1.18.1" \
        "matplotlib==3.11.2" \
        "torch==2.14.1"

    # Fail the build rather than the first job if an import is broken.
    python3 -c "import networkx, numpy, scipy, matplotlib, torch; \
print('networkx', networkx.__version__); \
print('numpy', numpy.__version__); \
print('scipy', scipy.__version__); \
print('matplotlib', matplotlib.__version__); \
print('torch', torch.__version__)"

%environment
    export MPLBACKEND=Agg
    export PYTHONUNBUFFERED=1

%labels
    Project Graph-De-Anonymization
    Purpose Report 1 reimplementation (seed-based / seed-free) and Adv-GD

%help
    Built by scripts/moes-cluster-scripts/build_container.sh into
    /data/$USER/Graph-De-Anonymization/graph_deanon.sif. Run things through the job scripts in that
    directory rather than by hand, so that every run leaves a record.
